# ---------------------------------------------------------------------------
# MIRA — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Supabase Dashboard -> Project Settings -> API.
#
#   cp .env.example .env.local           (macOS / Linux)
#   Copy-Item .env.example .env.local    (Windows PowerShell)
#
# NEVER commit `.env.local`. Never expose the service-role key to the browser.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe for the browser — it is always constrained by
# Row-Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. Server-side ONLY. It bypasses Row-Level
# Security, so it must never be prefixed with NEXT_PUBLIC_ and never imported
# into a Client Component. MIRA uses it for exactly two things: seeding the
# first System Administrator, and minting Owner/invited-user credentials from
# the admin API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment ------------------------------------------------------------

# The base URL of THIS deployment. Every generated link — invitations, auth
# redirects, the admin portal URL printed by the seed script — is built from
# it. There is no hardcoded domain anywhere in MIRA: whatever you set here is
# your base URL.
#
#   local          http://localhost:3000
#   Vercel preview  leave blank; VERCEL_URL is used automatically
#   production     https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- First-run seeding -----------------------------------------------------

# Credentials for the single System Administrator created by
# `npm run seed:admin`. The script is idempotent: if this account already
# exists it does nothing.
#
# !! CHANGE THE PASSWORD BEFORE THE APP IS REACHABLE FROM THE INTERNET.
# The seeded account is flagged `must_change_password`, so the admin portal
# forces a new password at first login — but do not rely on that alone.
SEED_ADMIN_EMAIL=madbrostech27@gmail.com
SEED_ADMIN_PASSWORD=Admin@1234567
SEED_ADMIN_NAME=System Administrator

# --- Product configuration -------------------------------------------------

# Self-service registration at /signup.
#
#   false  (default, recommended) — /signup only accepts an invitation token.
#          Owners are provisioned by a System Administrator; Users arrive via
#          an invitation from their Owner or HR.
#   true   — anyone may create an account. They still land in no workspace
#          until someone invites them; a public signup can never create a
#          System Administrator or an unattached Owner.
ALLOW_PUBLIC_SIGNUP=false
